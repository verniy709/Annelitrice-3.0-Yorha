<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <!-- Keep this file in its conditional load folder. The sequence completes each new behavior before defs are loaded. -->
    <Operation Class="PatchOperationSequence">
        <operations>
            <!-- Job list: add new empty values to all listed sleeves and gloves. -->
            <li Class="PatchOperationAdd">
                <xpath>Defs/NareisLib.ActionDef[defName="Anneli_YoRHa_GauntletsYoRHa_Left" or defName="Anneli_YoRHa_GauntletsYoRHa_Right" or defName="Anneli_YoRHa_LongGlovesYoRHa_Left" or defName="Anneli_YoRHa_LongGlovesYoRHa_Right" or defName="Anneli_Arm_YoRHaLTS_Left" or defName="Anneli_Arm_YoRHaLTS_Right"]/behaviors</xpath>
                <value>
                    <li>
                        <key>FleeAndCowerShort</key>
                        <value />
                    </li>
                    <li>
                        <key>CarryToEntityHolder</key>
                        <value />
                    </li>
                    <li>
                        <key>TransferBetweenEntityHolders</key>
                        <value />
                    </li>
                    <li>
                        <key>CarryToEntityHolderAlreadyHolding</key>
                        <value />
                    </li>
                    <li>
                        <key>TendEntity</key>
                        <value />
                    </li>
                    <li>
                        <key>BuildCubeSculpture</key>
                        <value />
                    </li>
                    <li>
                        <key>TakeBioferriteOutOfHarvester</key>
                        <value />
                    </li>
                    <li>
                        <key>FillIn</key>
                        <value />
                    </li>
                    <li>
                        <key>ReleaseEntity</key>
                        <value />
                    </li>
                    <li>
                        <key>ActivateMonolith</key>
                        <value />
                    </li>
                    <li>
                        <key>InvestigateMonolith</key>
                        <value />
                    </li>
                    <li>
                        <key>TalkCreepJoiner</key>
                        <value />
                    </li>
                    <li>
                        <key>PrisonerInterrogateIdentity</key>
                        <value />
                    </li>
                    <li>
                        <key>ActivitySuppression</key>
                        <value />
                    </li>
                    <li>
                        <key>UnnaturalCorpseAttack</key>
                        <value />
                    </li>
                    <li>
                        <key>UnnaturalCorpseSkip</key>
                        <value />
                    </li>
                    <li>
                        <key>GoldenCubePlay</key>
                        <value />
                    </li>
                    <li>
                        <key>ExecuteEntity</key>
                        <value />
                    </li>
                </value>
            </li>
            <!-- Common link settings: only the new empty values. -->
            <li Class="PatchOperationAdd">
                <xpath>Defs/NareisLib.ActionDef[defName="Anneli_YoRHa_GauntletsYoRHa_Left" or defName="Anneli_YoRHa_GauntletsYoRHa_Right" or defName="Anneli_YoRHa_LongGlovesYoRHa_Left" or defName="Anneli_YoRHa_LongGlovesYoRHa_Right" or defName="Anneli_Arm_YoRHaLTS_Left" or defName="Anneli_Arm_YoRHaLTS_Right"]/behaviors/li/value[not(*)]</xpath>
                <value>
                    <linkedWithAction>true</linkedWithAction>
                    <type_originalDefName>NareisLib.HandTypeDef_Anneli_Arm_Generic</type_originalDefName>
                    <linkedActionSyncDelta>0.2</linkedActionSyncDelta>
                </value>
            </li>
            <!-- Texture settings: Anneli_Arm_YoRHaLTS, both arms. Existing complete values are excluded. -->
            <li Class="PatchOperationAdd">
                <xpath>Defs/NareisLib.ActionDef[defName="Anneli_Arm_YoRHaLTS_Left" or defName="Anneli_Arm_YoRHaLTS_Right"]/behaviors/li/value[not(exPath)]</xpath>
                <value>
                    <exPath>Anneli_Arms/YoRHaLTS/</exPath>
                    <textures>
                        <li>Anneli_Arm_YoRHaLTS</li>
                    </textures>
                </value>
            </li>
            <!-- Texture settings: Anneli_YoRHa_GauntletsYoRHa, both arms. Existing complete values are excluded. -->
            <li Class="PatchOperationAdd">
                <xpath>Defs/NareisLib.ActionDef[defName="Anneli_YoRHa_GauntletsYoRHa_Left" or defName="Anneli_YoRHa_GauntletsYoRHa_Right"]/behaviors/li/value[not(exPath)]</xpath>
