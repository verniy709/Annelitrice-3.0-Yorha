                <xpath>Defs/NareisLib.ActionDef[defName="Anneli_YoRHa_GauntletsYoRHa_Left" or defName="Anneli_YoRHa_LongGlovesYoRHa_Left" or defName="Anneli_Arm_YoRHaLTS_Left"]/behaviors/li/value[not(textureLevelsName)]</xpath>
                <value>
                    <textureLevelsName>Anneli_Arm_Generic_Left</textureLevelsName>
                </value>
            </li>
            <!-- Arm link: Right. Existing complete values are excluded. -->
            <li Class="PatchOperationAdd">
                <xpath>Defs/NareisLib.ActionDef[defName="Anneli_YoRHa_GauntletsYoRHa_Right" or defName="Anneli_YoRHa_LongGlovesYoRHa_Right" or defName="Anneli_Arm_YoRHaLTS_Right"]/behaviors/li/value[not(textureLevelsName)]</xpath>
