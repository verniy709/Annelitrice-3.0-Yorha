                    <textures>
                        <li>Anneli_YoRHa_GauntletsYoRHa</li>
                    </textures>
                </value>
            </li>
            <!-- Texture settings: Anneli_YoRHa_LongGlovesYoRHa, both arms. Existing complete values are excluded. -->
            <li Class="PatchOperationAdd">
                <xpath>Defs/NareisLib.ActionDef[defName="Anneli_YoRHa_LongGlovesYoRHa_Left" or defName="Anneli_YoRHa_LongGlovesYoRHa_Right"]/behaviors/li/value[not(exPath)]</xpath>
